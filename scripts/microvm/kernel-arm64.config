# arm64-specific additions to kernel-common.config.
#
# QEMU's `-machine virt` auto-generates a device tree describing a generic
# ECAM PCIe host bridge; this is the driver that lets virtio-net-pci be
# discovered from it, mirroring the amd64 microvm+pcie=on/ACPI path without
# needing ACPI on arm64.
CONFIG_PCI_HOST_GENERIC=y

# Serial console (QEMU `-nographic`, kernel `console=ttyAMA0`): the PL011
# UART `-machine virt` exposes.
CONFIG_ARM_AMBA=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# The guest only accepts native 64-bit ELF images.
CONFIG_COMPAT=n
