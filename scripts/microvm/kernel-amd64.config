# amd64-specific additions to kernel-common.config.
#
# QEMU's `-machine microvm,pcie=on,acpi=on` presents a conventional
# ACPI-enumerated PCIe topology, so virtio-net-pci is discovered like real
# hardware without hand-written virtio_mmio.device= parameters.
CONFIG_ACPI=y

# Serial console (QEMU `-nographic`, kernel `console=ttyS0`).
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# The native VMM exposes exactly COM1 for diagnostics and COM2 for the
# authenticated guest-agent channel. Do not let a fresh defconfig probe two
# additional legacy UARTs that do not exist in the device model.
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2

# The guest only accepts native 64-bit ELF images.
CONFIG_IA32_EMULATION=n
CONFIG_X86_X32_ABI=n
