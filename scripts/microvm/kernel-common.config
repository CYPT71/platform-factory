# Merged (with an arch-specific kernel-<arch>.config) onto the stock
# defconfig by build-kernel.sh. Only forces what scripts/microvm actually
# needs built in (=y); everything else keeps the defconfig's choice, except
# for the attack-surface reductions at the bottom of this file.

# Boot from an initrd passed via `-initrd` (gzip-compressed cpio).
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# One virtio-net-pci NIC, same device model on both architectures (x86_64
# microvm with pcie=on; arm64 virt's built-in PCIe host bridge). This is
# the QEMU fallback path (scripts/microvm/run-microvm.sh); it shares this
# kernel image with the native KVM backend below, which cannot use PCI at
# all - internal/hypervisor/kvm/linux_pci.go deliberately keeps the guest's
# PCI config-space probe permanently negative (no host bridge exists), so
# CONFIG_VIRTIO_PCI here is exercised only by the QEMU path.
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_NET=y
CONFIG_INET=y

# The native KVM backend's own virtio transport: virtio-mmio, not
# virtio-pci, matching its no-PCI-host-bridge device model above. x86 has
# no ACPI/devicetree path to auto-discover MMIO virtio devices the way
# arm64's device tree or a PCI bus would, so CMDLINE_DEVICES is required -
# it's what makes `virtio_mmio.device=SIZE@BASE:IRQ` on the kernel command
# line register a device at all (see internal/hypervisor/kvm's virtio-mmio
# transport for the addresses/IRQs it actually uses). CONFIG_VIRTIO_BLK
# backs the same backend's virtio-blk device; the QEMU path above has never
# used a virtio disk (initrd-only boot), so this is new for both paths.
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y

# No udev, no userspace DHCP client. The QEMU/KVM paths use the kernel's
# own `ip=` static autoconfiguration (see run-microvm.sh), matching
# SLIRP's well-known static addressing. The native HVF path (Apple
# Virtualization.framework, internal/hypervisor/hvf) has no static-IP
# equivalent - VZNATNetworkDeviceAttachment requires the guest to
# negotiate an address itself - so CONFIG_IP_PNP_DHCP lets the same
# kernel also do `ip=dhcp` via its own tiny built-in DHCP client
# (internal/hypervisor/kvm's static `ip=` boot param still works
# unchanged; DHCP support being compiled in doesn't change that path).
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

# The kernel populates /dev itself; there is no udev in this image.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Required by both earlycon and the architecture-specific serial console.
CONFIG_PRINTK=y

# The initramfs installs native static ELF executables for PID 1 and the OCI
# application. No userspace ELF loader is present.
CONFIG_BINFMT_ELF=y

# Required by the Go Linux runtime and normal network/timer based services.
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y

CONFIG_TTY=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# This guest executes a real PID 1 and application processes.
CONFIG_MULTIUSER=y

# Don't let a newer host compiler's -Werror default break an older kernel.
CONFIG_WERROR=n

# Attack-surface reductions, verified against kernel-hardening-checker
# (KSPP/grsecurity/CLIP OS recommendations) and, symbol by symbol, against
# the actual resolved .config: every option below was already a plain
# bool =y under the stock defconfig (never =m), so turning it off is a
# real, isolated removal that doesn't ripple into anything else. This
# kernel boots one initrd, execs exactly one process as PID 1, and is
# thrown away when the VM powers off, so none of it is ever exercised.
# Nothing here touches boot-critical config (console, virtio-net, initrd,
# IP autoconfig, devtmpfs), which stay forced =y above regardless.
#
# Deliberately NOT set here: CONFIG_MODULES. Leaving it at the defconfig's
# own =y is correct, not an oversight - this build never runs `make
# modules`/`modules_install` and the image has no modprobe or /lib/modules,
# so every driver the defconfig marks =m is simply never compiled into
# the final image at all and never loaded. Forcing CONFIG_MODULES=n was
# tried and reverted: with modules off, Kconfig can no longer leave those
# drivers as =m, so it silently promotes hundreds of them (netfilter
# conntrack, IPv6, cpufreq governors, assorted SoC/PMU drivers, ...)
# straight to =y - permanently compiled in and active - which is a net
# *increase* in attack surface on this general-purpose defconfig, not a
# reduction. Likewise not set: CONFIG_VT, CONFIG_IO_URING, CONFIG_KALLSYMS,
# CONFIG_DEBUG_FS - Kconfig silently re-enables them regardless of what's
# requested here, pulled back in by the large DRM/perf/ftrace surface this
# defconfig already turns on. Removing them for real would mean auditing and
# trimming that surface directly, a larger change than this file attempts.

# No /dev/mem or /dev/port: raw physical memory/IO-port access from inside
# the guest.
CONFIG_DEVMEM=n
CONFIG_DEVPORT=n
# No kexec, hibernation, or crash dump - each is a kernel-to-kernel or
# kernel-to-userspace transition this throwaway VM never needs.
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_HIBERNATION=n
CONFIG_CRASH_DUMP=n
# No legacy framebuffer console or legacy PTYs/TIOCSTI: this image only
# ever has a single serial console (`-nographic`, `console=ttyS0`/`ttyAMA0`).
CONFIG_FB=n
CONFIG_LEGACY_PTYS=n
CONFIG_LEGACY_TIOCSTI=n
# eBPF is one of the most exploited Linux kernel subsystems in recent
# years; a single stdlib Go/static binary never touches it.
CONFIG_BPF_SYSCALL=n
# No interactive debugging/console surface: this is a fully automated,
# non-interactive boot (QEMU itself already runs with `-monitor none`).
CONFIG_MAGIC_SYSRQ=n
# SYN cookies: cheap, standard protection against SYN-flood DoS for a
# kernel whose entire purpose is running a network-facing service.
CONFIG_SYN_COOKIES=y
