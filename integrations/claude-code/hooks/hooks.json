{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pf-freeze-guard.js\"",
            "timeout": 5
          }
        ],
        "description": "Warn (or deny with PF_GUARD_STRICT=1) when pf build/publish/launch/deploy runs with a stale freeze lock"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pf-freeze-guard.js\"",
            "timeout": 5
          }
        ],
        "description": "Remind to run pf freeze after a dependency manifest changes"
      }
    ]
  }
}
