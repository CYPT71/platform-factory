{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-factory.dev/schemas/pf-v1.schema.json",
  "title": "Platform Factory project v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "language": {"type": "string"},
    "dependency_management": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["none", "manifest", "unresolved", "external", "unknown"]}, "file": {"type": "string"}}},
    "project": {"type": "string"}, "runtime": {"type": "string"}, "artifact": {"type": "string"},
    "output": {"type": "string"}, "image": {"type": "string"}, "tag": {"type": "string"},
    "platform": {"enum": ["linux/amd64", "linux/arm64"]}, "entrypoint": {"type": "string"}, "profile": {"type": "string"},
    "args": {"type": "array", "items": {"type": "string"}}, "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "user": {"type": "string"}, "isolation": {"enum": ["container", "microvm"]}, "runtime_engine": {"enum": ["docker", "podman"]},
    "network": {"type": "string"}, "ports": {"type": "array", "items": {"type": "string"}}, "include_project": {"type": "boolean"},
    "include": {"$ref": "#/$defs/dependencies"}, "shared_deps": {"$ref": "#/$defs/dependencies"},
    "freeze_command": {"$ref": "#/$defs/command"}, "build_command": {"$ref": "#/$defs/command"},
    "semantic_layers": {"type": "boolean"}, "language_plugin": {"type": "boolean"},
    "legacy_disks": {"type": "object", "additionalProperties": false, "required": ["boot"], "properties": {"boot": {"type": "string"}, "data": {"type": "array", "items": {"type": "string"}}}}
  },
  "$defs": {
    "command": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source", "destination"], "properties": {"source": {"type": "string"}, "destination": {"type": "string", "pattern": "^/"}, "category": {"enum": ["toolchain", "dependencies", "application", "metadata"]}}}}
  }
}
